<UserControl x:Class="Camzivo.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource Font.Ui}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16" MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="{Binding DataNote}" Style="{StaticResource Meta}" TextWrapping="Wrap" Margin="0,4,0,0" />

            <Border Style="{StaticResource SectionCard}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="APPEARANCE" Style="{StaticResource SectionHeader}" />
                    <TextBlock Text="{Binding AppearanceNote}" Style="{StaticResource Meta}" TextWrapping="Wrap" Margin="0,0,0,10" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Dark" MinWidth="96" Height="32"
                                Command="{Binding DataContext.SetThemeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="true" AutomationProperties.Name="Use dark theme">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.IsDark, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextOnAccent}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Light" MinWidth="96" Height="32" Margin="8,0,0,0"
                                Command="{Binding DataContext.SetThemeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="false" AutomationProperties.Name="Use light theme">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.IsDark, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                            <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextOnAccent}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SectionCard}" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock Text="STARTUP" Style="{StaticResource SectionHeader}" />
                    <TextBlock Text="Startup never blocks on discovery or a recorder search." Style="{StaticResource Meta}" Margin="0,0,0,8" />
                    <ComboBox ItemsSource="{Binding StartupChoices}" SelectedItem="{Binding SelectedStartup}"
                              DisplayMemberPath="Label" Width="300" HorizontalAlignment="Left"
                              AutomationProperties.Name="Startup page" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SectionCard}" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock Text="EVENTS" Style="{StaticResource SectionHeader}" />
                    <ComboBox ItemsSource="{Binding RetentionChoices}" SelectedItem="{Binding SelectedRetention}"
                              DisplayMemberPath="Label" Width="180" HorizontalAlignment="Left"
                              AutomationProperties.Name="Event retention" />
                    <TextBlock Text="{Binding RetentionNote}" Style="{StaticResource Meta}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SectionCard}" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock Text="VIDEO AND PERFORMANCE" Style="{StaticResource SectionHeader}" />
                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="Decode budget" Style="{StaticResource Body}" />
                        <TextBlock Text="Automatic" Style="{StaticResource Mono}" HorizontalAlignment="Right" />
                    </Grid>
                    <TextBlock Text="{Binding DecodeBudgetText}" Style="{StaticResource Meta}" TextWrapping="Wrap" Margin="0,0,0,10" />
                    <Grid>
                        <TextBlock Text="Credentials" Style="{StaticResource Body}" />
                        <TextBlock Text="DPAPI" Style="{StaticResource Mono}" HorizontalAlignment="Right" />
                    </Grid>
                    <TextBlock Text="{Binding CredentialText}" Style="{StaticResource Meta}" TextWrapping="Wrap" Margin="0,3,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SectionCard}" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock Text="STORAGE" Style="{StaticResource SectionHeader}" />
                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="Configuration" Style="{StaticResource Body}" />
                        <TextBlock Text="{Binding ConfigPath}" Style="{StaticResource Mono}" HorizontalAlignment="Right"
                                   TextTrimming="CharacterEllipsis" MaxWidth="440" ToolTip="{Binding ConfigPath}" />
                    </Grid>
                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="Database" Style="{StaticResource Body}" />
                        <TextBlock Text="{Binding DatabasePath}" Style="{StaticResource Mono}" HorizontalAlignment="Right"
                                   TextTrimming="CharacterEllipsis" MaxWidth="440" ToolTip="{Binding DatabasePath}" />
                    </Grid>
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="Exports" Style="{StaticResource Body}" />
                        <TextBlock Text="{Binding ExportRoot}" Style="{StaticResource Mono}" HorizontalAlignment="Right"
                                   TextTrimming="CharacterEllipsis" MaxWidth="440" ToolTip="{Binding ExportRoot}" />
                    </Grid>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Open export folder" Style="{StaticResource SecondaryButton}" Height="30"
                                Command="{Binding OpenExportFolderCommand}" />
                        <Button Content="Open log folder" Style="{StaticResource GhostButton}" Height="30" Margin="8,0,0,0"
                                Command="{Binding OpenLogFolderCommand}" />
                        <Button Content="Camera health" Style="{StaticResource GhostButton}" Height="30" Margin="8,0,0,0"
                                Command="{Binding DataContext.ShowHealthCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SectionCard}" Margin="0,10,0,0">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="CAMZIVO VMS" Style="{StaticResource SectionHeader}" />
                        <TextBlock Style="{StaticResource Meta}" TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left"
                                   Text="Local-first Windows video management. Live view, recording search, evidence export and event history. Real Dahua hardware compatibility is not yet verified." />
                    </StackPanel>
                    <TextBlock Text="{Binding VersionLabel}" Style="{StaticResource Mono}" HorizontalAlignment="Right"
                               VerticalAlignment="Top" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
