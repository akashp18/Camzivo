<UserControl x:Class="Camzivo.Desktop.Views.ExportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource Font.Ui}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Evidence exports" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="{Binding Summary}" Style="{StaticResource Meta}" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="Open folder" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                        Command="{Binding OpenFolderCommand}" />
                <Button Content="Refresh" Style="{StaticResource GhostButton}" Command="{Binding RefreshCommand}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="{DynamicResource Brush.AccentSoft}" CornerRadius="6" Padding="10,6" Margin="0,0,0,10">
            <TextBlock Style="{StaticResource Meta}" TextWrapping="Wrap"
                       Text="Each export is an MP4 written from the recorder's own stream, with a SHA-256 sidecar and a JSON manifest beside it. Verify recomputes the hash and compares it with the sidecar." />
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Panel}" Padding="0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource TableHeader}">
                    <Grid Margin="12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="1.4*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="FILE" Style="{StaticResource TableHeaderText}" />
                        <TextBlock Grid.Column="1" Text="CAMERA" Style="{StaticResource TableHeaderText}" />
                        <TextBlock Grid.Column="2" Text="RECORDED RANGE" Style="{StaticResource TableHeaderText}" />
                        <TextBlock Grid.Column="3" Text="EXPORTED" Style="{StaticResource TableHeaderText}" />
                        <TextBlock Grid.Column="4" Text="SIZE" Style="{StaticResource TableHeaderText}" />
                    </Grid>
                </Border>

                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Rows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource TableRow}" Padding="0,7" MinHeight="44"
                                            AutomationProperties.Name="{Binding AutomationName}">
                                        <Grid Margin="12,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="1.4*" />
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Path}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Verification}" Style="{StaticResource Micro}" />
                                                <TextBlock Text="{Binding MissingText}" Style="{StaticResource Micro}"
                                                           Foreground="{DynamicResource Brush.Critical}"
                                                           Visibility="{Binding Exists, Converter={StaticResource InverseBoolToVis}}" />
                                            </StackPanel>

                                            <TextBlock Grid.Column="1" Text="{Binding CameraName}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />

                                            <TextBlock Grid.Column="2" Text="{Binding RangeText}" Style="{StaticResource Mono}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                                            <TextBlock Grid.Column="3" Text="{Binding CreatedText}" Style="{StaticResource Meta}"
                                                       VerticalAlignment="Center" />

                                            <TextBlock Grid.Column="4" Text="{Binding Bytes, Converter={StaticResource BytesToSize}}"
                                                       Style="{StaticResource Mono}" VerticalAlignment="Center" />

                                            <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="Verify" Style="{StaticResource GhostButton}" Height="26" Padding="8,0"
                                                        Command="{Binding DataContext.VerifyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        IsEnabled="{Binding Exists}" />
                                                <Button Content="Show" Style="{StaticResource GhostButton}" Height="26" Padding="8,0"
                                                        Margin="4,0,0,0"
                                                        Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        IsEnabled="{Binding Exists}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasRows}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Path Style="{StaticResource IconPath}" Width="26" Height="26" HorizontalAlignment="Center"
                              Fill="{DynamicResource Brush.TextMuted}" Data="{StaticResource Icon.Exports}" />
                        <TextBlock Text="No evidence exported yet" Style="{StaticResource SectionTitle}"
                                   HorizontalAlignment="Center" Margin="0,12,0,0" />
                        <TextBlock Text="{Binding EmptyText}" Style="{StaticResource Meta}" TextAlignment="Center"
                                   TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>
            </DockPanel>
        </Border>

        <TextBlock Grid.Row="2" Text="{Binding ErrorText}" Style="{StaticResource ErrorMessage}"
                   VerticalAlignment="Bottom" Margin="0,0,0,8"
                   Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
    </Grid>
</UserControl>
