<UserControl x:Class="Camzivo.Desktop.Views.HealthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource Font.Ui}">

    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="{Binding Summary}" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="One line per camera that is not healthy, with the reason and the next check to make."
                       Style="{StaticResource Meta}" Margin="0,4,0,0" />
        </StackPanel>

        <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Rows}" VerticalAlignment="Top">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Panel}" Padding="14" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border CornerRadius="2">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource Brush.Warning}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCritical}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource Brush.Critical}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="12,0,12,0">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" />
                                        <TextBlock Text="{Binding Explanation}" Style="{StaticResource Meta}"
                                                   TextWrapping="Wrap" Margin="0,4,0,0" MaxWidth="760" HorizontalAlignment="Left" />
                                        <TextBlock Text="{Binding Actions}" Style="{StaticResource Meta}"
                                                   Foreground="{DynamicResource Brush.AccentText}"
                                                   TextWrapping="Wrap" Margin="0,6,0,0" MaxWidth="760" HorizontalAlignment="Left" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding Camera}" Style="{StaticResource Body}" HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding SeverityLabel}" Style="{StaticResource Micro}"
                                                   Foreground="{DynamicResource Brush.TextMuted}" HorizontalAlignment="Right" Margin="0,4,0,0" />
                                        <Border Style="{StaticResource Chip}" HorizontalAlignment="Right" Margin="0,6,0,0">
                                            <TextBlock Text="{Binding Code}" Style="{StaticResource Micro}" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                    MaxWidth="440">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Panel}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasRows}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <Path Style="{StaticResource IconPath}" Width="24" Height="24" HorizontalAlignment="Center"
                          Fill="{DynamicResource Brush.Success}" Data="{StaticResource Icon.Check}" />
                    <TextBlock Text="All clear" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center" Margin="0,10,0,0" />
                    <TextBlock Style="{StaticResource Meta}" TextAlignment="Center" Margin="0,6,0,0" TextWrapping="Wrap"
                               Text="No camera is reporting a fault. When one does, this page explains what happened and what to check." />
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
