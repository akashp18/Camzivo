<UserControl x:Class="Camzivo.Desktop.Views.LiveWallView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Camzivo.Desktop.ViewModels"
             FontFamily="{StaticResource Font.Ui}">

    <Grid>
        <Border Style="{StaticResource Panel}" Padding="1" ClipToBounds="True" Background="{DynamicResource Brush.Border}">
            <ItemsControl ItemsSource="{Binding Tiles}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="{Binding Rows}" Columns="{Binding Columns}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource Brush.VideoSurface}" Margin="0,0,1,1"
                                AutomationProperties.Name="{Binding AutomationName}"
                                SizeChanged="Tile_SizeChanged"
                                MouseLeftButtonDown="Tile_MouseLeftButtonDown"
                                AllowDrop="True"
                                DragOver="Tile_DragOver"
                                DragLeave="Tile_DragLeave"
                                Drop="Tile_Drop">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentText}" />
                                            <Setter Property="BorderThickness" Value="2" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Grid>
                                <Image Source="{Binding Frame}" Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="LowQuality"
                                       SnapsToDevicePixels="True">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasFrame}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>

                                <Rectangle Fill="{StaticResource HatchBrush}" Opacity="0.12">
                                    <Rectangle.Style>
                                        <Style TargetType="Rectangle">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Rectangle.Style>
                                </Rectangle>

                                <TextBlock Text="{Binding Detail}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           TextAlignment="Center" TextWrapping="Wrap" MaxWidth="180">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Micro}">
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.VideoTextMuted}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasFrame}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- Name and quality: a compact band, never a large overlay. -->
                                <Border VerticalAlignment="Top" Background="{DynamicResource Brush.VideoScrim}" Padding="8,5">
                                    <Grid>
                                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="#F2F4F6" TextTrimming="CharacterEllipsis"
                                                   Margin="0,0,52,0" />
                                        <Border HorizontalAlignment="Right" ToolTip="{Binding QualityHint}">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource Chip}">
                                                    <Setter Property="Background" Value="#33FFFFFF" />
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasCamera}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding QualityChip}" Style="{StaticResource Micro}" Foreground="#F2F4F6" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="8,0,0,6">
                                    <Ellipse Width="6" Height="6" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{DynamicResource Brush.TextMuted}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:TileStatus.Live}">
                                                        <Setter Property="Fill" Value="{DynamicResource Brush.Success}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:TileStatus.Preview}">
                                                        <Setter Property="Fill" Value="{DynamicResource Brush.Info}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:TileStatus.Queued}">
                                                        <Setter Property="Fill" Value="{DynamicResource Brush.Warning}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:TileStatus.Offline}">
                                                        <Setter Property="Fill" Value="{DynamicResource Brush.Critical}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Micro}"
                                               Foreground="#A8B1BC" Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>

                                <Border IsHitTestVisible="False" Background="#66101820"
                                        BorderBrush="{DynamicResource Brush.AccentText}" BorderThickness="2">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="DROP TO PLACE" Style="{StaticResource Micro}" Foreground="#F2F4F6"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- First run: one explanation, not nine identical hints. -->
        <Border Background="{DynamicResource Brush.Canvas}" Padding="24"
                Visibility="{Binding ShowOnboarding, Converter={StaticResource BoolToVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460">
                <Path Style="{StaticResource IconPath}" Width="28" Height="28" HorizontalAlignment="Center"
                      Fill="{DynamicResource Brush.TextMuted}" Data="{StaticResource Icon.Live}" />
                <TextBlock Text="No cameras yet" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center" Margin="0,14,0,0" />
                <TextBlock Style="{StaticResource Meta}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0"
                           Text="Add a camera or recorder in Devices. Camzivo tests the device before saving it, then places it on the wall automatically." />
                <Button Content="Add a camera" Style="{StaticResource PrimaryButton}" Margin="0,16,0,0"
                        HorizontalAlignment="Center"
                        Command="{Binding DataContext.Devices.AddCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
