<UserControl x:Class="Camzivo.Desktop.Views.LiveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Camzivo.Desktop.Views"
             FontFamily="{StaticResource Font.Ui}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===================== Camera list ===================== -->
        <Border Grid.Column="0" Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0">
            <DockPanel Margin="12,12,12,12">
                <StackPanel DockPanel.Dock="Top">
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="CAMERAS" Style="{StaticResource Micro}" VerticalAlignment="Center" />
                        <Button Style="{StaticResource IconButton}" Width="26" Height="26" HorizontalAlignment="Right"
                                Command="{Binding DataContext.Devices.AddCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                ToolTip="Add a camera or recorder"
                                AutomationProperties.Name="Add camera">
                            <Path Style="{StaticResource IconPath}" Width="12" Height="12"
                                  Fill="{DynamicResource Brush.TextSecondary}" Data="{StaticResource Icon.Plus}" />
                        </Button>
                    </Grid>

                    <Grid>
                        <TextBox Style="{StaticResource SearchBox}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Search cameras"
                                 ToolTip="Filter cameras by name or group" />
                        <TextBlock Text="Search cameras" Style="{StaticResource Meta}" Margin="10,0,0,0"
                                   VerticalAlignment="Center" IsHitTestVisible="False"
                                   Visibility="{Binding SearchText, Converter={StaticResource EmptyToVis}, ConverterParameter=invert}" />
                        <Path Style="{StaticResource IconPath}" Width="12" Height="12" HorizontalAlignment="Right"
                              Margin="0,0,10,0" VerticalAlignment="Center" IsHitTestVisible="False"
                              Fill="{DynamicResource Brush.TextMuted}" Data="{StaticResource Icon.Search}" />
                    </Grid>

                    <TextBlock Text="{Binding CameraCountText}" Style="{StaticResource Mono}" Margin="0,8,0,0" />
                    <Border Style="{StaticResource Hairline}" Margin="0,10,0,0" />
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding FilteredCameras}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="6,7" CornerRadius="5" Margin="0,0,0,1"
                                            Focusable="True"
                                            ToolTip="Click to place on the wall, or drag onto a tile"
                                            PreviewMouseLeftButtonDown="Camera_PreviewMouseLeftButtonDown"
                                            PreviewMouseMove="Camera_PreviewMouseMove">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick"
                                                          Command="{Binding DataContext.AssignCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                          CommandParameter="{Binding}" />
                                            <KeyBinding Key="Enter"
                                                        Command="{Binding DataContext.AssignCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                            <KeyBinding Key="Space"
                                                        Command="{Binding DataContext.AssignCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                        </Border.InputBindings>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="BorderBrush" Value="Transparent" />
                                                <Setter Property="BorderThickness" Value="1" />
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
                                                    </Trigger>
                                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontSize="12.5" TextTrimming="CharacterEllipsis"
                                                           AutomationProperties.Name="{Binding Name}" />
                                                <TextBlock Text="{Binding Group}" Style="{StaticResource Micro}"
                                                           Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Border Grid.Column="1" Width="6" Height="6" CornerRadius="3"
                                                    VerticalAlignment="Center" Margin="6,0,0,0"
                                                    Background="{DynamicResource Brush.Accent}"
                                                    Visibility="{Binding IsAssigned, Converter={StaticResource BoolToVis}}"
                                                    ToolTip="Placed on the wall" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="No cameras match this search." Style="{StaticResource Meta}"
                                   Margin="6,8,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding HasNoMatches, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ===================== Wall and controls ===================== -->
        <Grid Grid.Column="1" Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource Toolbar}">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ItemsControl ItemsSource="{Binding LayoutOptions}" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Label}" Command="{Binding Command}" ToolTip="{Binding Tooltip}"
                                            Height="26" MinWidth="30" Padding="7,0" Margin="0,0,2,0">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SegmentButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.TextOnAccent}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Style="{StaticResource Hairline}" Width="1" Height="18" Margin="10,0" />

                        <Grid Width="158" Height="28" Margin="0,0,6,0">
                            <ComboBox Height="28" ItemsSource="{Binding Layouts}" SelectedItem="{Binding SelectedLayout}"
                                      DisplayMemberPath="Name"
                                      AutomationProperties.Name="Saved layouts"
                                      ToolTip="Saved camera layouts" />
                            <TextBlock Text="No saved layouts" Style="{StaticResource Meta}" Margin="10,0,0,0"
                                       VerticalAlignment="Center" IsHitTestVisible="False"
                                       Visibility="{Binding Layouts.Count, Converter={StaticResource ZeroToVis}}" />
                        </Grid>
                        <Button Style="{StaticResource IconButton}" Width="28" Height="28" Command="{Binding ApplySavedLayoutCommand}"
                                CommandParameter="{Binding SelectedLayout}" ToolTip="Apply this layout"
                                AutomationProperties.Name="Apply saved layout" Margin="0,0,2,0">
                            <Path Style="{StaticResource IconPath}" Width="13" Height="13"
                                  Fill="{DynamicResource Brush.TextSecondary}" Data="{StaticResource Icon.Check}" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" Width="28" Height="28" Command="{Binding BeginSaveLayoutCommand}"
                                ToolTip="Save the current wall as a layout" AutomationProperties.Name="Save layout">
                            <Path Style="{StaticResource IconPath}" Width="13" Height="13"
                                  Fill="{DynamicResource Brush.TextSecondary}" Data="{StaticResource Icon.Save}" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" Width="28" Height="28" Command="{Binding BeginRenameLayoutCommand}"
                                ToolTip="Rename the selected layout" AutomationProperties.Name="Rename layout">
                            <Path Style="{StaticResource IconPath}" Width="13" Height="13"
                                  Fill="{DynamicResource Brush.TextSecondary}" Data="{StaticResource Icon.Edit}" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" Width="28" Height="28" Command="{Binding BeginDuplicateLayoutCommand}"
                                ToolTip="Duplicate the selected layout" AutomationProperties.Name="Duplicate layout">
                            <Path Style="{StaticResource IconPath}" Width="13" Height="13"
                                  Fill="{DynamicResource Brush.TextSecondary}" Data="{StaticResource Icon.Duplicate}" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" Width="28" Height="28" Command="{Binding DeleteLayoutCommand}"
                                ToolTip="Delete the selected layout" AutomationProperties.Name="Delete layout">
                            <Path Style="{StaticResource IconPath}" Width="13" Height="13"
                                  Fill="{DynamicResource Brush.TextSecondary}" Data="{StaticResource Icon.Trash}" />
                        </Button>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource GhostButton}" Height="28" Command="{Binding SnapshotCommand}"
                                ToolTip="Save the presented frame as a PNG with camera name and timestamp">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource IconPath}" Width="13" Height="13"
                                      Fill="{DynamicResource Brush.TextSecondary}" Data="{StaticResource Icon.Snapshot}" />
                                <TextBlock Text="Snapshot" Margin="6,0,0,0" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Height="28" Margin="4,0,0,0" Command="{Binding ClearSelectedCommand}"
                                ToolTip="Empty the selected tile (Ctrl+Z restores it)">
                            <TextBlock Text="Clear tile" FontSize="12" />
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Height="28" Margin="4,0,0,0" Command="{Binding OpenOnDisplayCommand}"
                                ToolTip="Open this wall on another display" AutomationProperties.Name="Open wall on another display">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource IconPath}" Width="13" Height="13"
                                      Fill="{DynamicResource Brush.TextSecondary}" Data="{StaticResource Icon.Monitor}" />
                                <TextBlock Text="Display" Margin="6,0,0,0" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Height="28" Margin="4,0,0,0"
                                Command="{Binding DataContext.ToggleFullScreenCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                ToolTip="Fullscreen (F11)" AutomationProperties.Name="Fullscreen">
                            <Path Style="{StaticResource IconPath}" Width="13" Height="13"
                                  Fill="{DynamicResource Brush.TextSecondary}" Data="{StaticResource Icon.Fullscreen}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Inline naming panel: a layout name is one field, not a dialog. -->
            <Border Grid.Row="1" Style="{StaticResource SectionCard}" Padding="12" Margin="0,8,0,0"
                    Visibility="{Binding IsLayoutEditorOpen, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="{Binding LayoutEditorTitle}" Style="{StaticResource Micro}" Margin="0,0,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="LayoutNameBox" Style="{StaticResource SearchBox}" Height="30"
                                 Text="{Binding LayoutEditorName, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="LayoutName_KeyDown"
                                 AutomationProperties.Name="Layout name" />
                        <Button Grid.Column="1" Content="Cancel" Style="{StaticResource SecondaryButton}" Height="30"
                                Margin="8,0,0,0" Command="{Binding CancelLayoutCommand}" />
                        <Button Grid.Column="2" Content="Save" Style="{StaticResource PrimaryButton}" Height="30"
                                Margin="6,0,0,0" Command="{Binding ConfirmLayoutCommand}" />
                    </Grid>
                    <TextBlock Text="{Binding LayoutEditorError}" Style="{StaticResource ErrorMessage}" Margin="0,6,0,0"
                               Visibility="{Binding HasLayoutEditorError, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Border>

            <!-- Contextual PTZ: only when the selected camera answered its PTZ service. -->
            <Border Grid.Row="2" Style="{StaticResource Toolbar}" Margin="0,8,0,0"
                    Visibility="{Binding DataContext.PtzAvailable, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="PTZ" Style="{StaticResource Micro}" VerticalAlignment="Center" Margin="4,0,10,0" />
                    <Button Content="◀" Style="{StaticResource GhostButton}" Height="26" Padding="8,0" Margin="0,0,3,0"
                            Command="{Binding DataContext.PtzNudgeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="left" ToolTip="Pan left" />
                    <Button Content="▲" Style="{StaticResource GhostButton}" Height="26" Padding="8,0" Margin="0,0,3,0"
                            Command="{Binding DataContext.PtzNudgeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="up" ToolTip="Tilt up" />
                    <Button Content="▼" Style="{StaticResource GhostButton}" Height="26" Padding="8,0" Margin="0,0,3,0"
                            Command="{Binding DataContext.PtzNudgeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="down" ToolTip="Tilt down" />
                    <Button Content="▶" Style="{StaticResource GhostButton}" Height="26" Padding="8,0" Margin="0,0,3,0"
                            Command="{Binding DataContext.PtzNudgeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="right" ToolTip="Pan right" />
                    <Button Content="+" Style="{StaticResource GhostButton}" Height="26" Padding="8,0" Margin="0,0,3,0"
                            Command="{Binding DataContext.PtzNudgeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="zoomIn" ToolTip="Zoom in" />
                    <Button Content="−" Style="{StaticResource GhostButton}" Height="26" Padding="8,0" Margin="0,0,8,0"
                            Command="{Binding DataContext.PtzNudgeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="zoomOut" ToolTip="Zoom out" />
                    <Button Content="Stop" Style="{StaticResource SecondaryButton}" Height="26" Padding="10,0" Margin="0,0,12,0"
                            Command="{Binding DataContext.PtzStopCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            ToolTip="Stop movement immediately" />
                    <ComboBox Width="130" Height="26" VerticalContentAlignment="Center"
                              ItemsSource="{Binding DataContext.PtzPresets, RelativeSource={RelativeSource AncestorType=Window}}"
                              SelectedItem="{Binding DataContext.SelectedPtzPreset, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                              DisplayMemberPath="Name" Margin="0,0,4,0"
                              ToolTip="Presets reported by the camera" />
                    <Button Content="Go" Style="{StaticResource GhostButton}" Height="26" Padding="8,0"
                            Command="{Binding DataContext.PtzGotoPresetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            ToolTip="Move to the selected preset" />
                    <TextBlock Text="{Binding DataContext.PtzDetail, RelativeSource={RelativeSource AncestorType=Window}}"
                               Style="{StaticResource Meta}" VerticalAlignment="Center" Margin="12,0,0,0" />
                </StackPanel>
            </Border>

            <views:LiveWallView Grid.Row="3" Margin="0,8,0,0" />

            <Border Grid.Row="4" Background="{DynamicResource Brush.NotificationSurface}"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="6" Padding="10,6"
                    Margin="0,8,0,0"
                    Visibility="{Binding DataContext.HasToast, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding DataContext.Toast, RelativeSource={RelativeSource AncestorType=Window}}"
                           Style="{StaticResource Meta}" TextWrapping="Wrap" />
            </Border>

            <Grid Grid.Row="5" Margin="2,8,0,0">
                <TextBlock Text="{Binding LayoutSummary}" Style="{StaticResource Mono}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="Double-click a tile to view it alone · Ctrl+Z undoes placement"
                               Style="{StaticResource Meta}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
