<UserControl x:Class="Camzivo.Desktop.Controls.DateField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource Font.Ui}">

    <UserControl.Resources>
        <Style x:Key="CalendarDayButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsToday}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                    <Setter Property="BorderThickness" Value="1" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.TextOnAccent}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Button x:Name="Field" Style="{StaticResource SecondaryButton}" Height="32" MinWidth="168"
                Click="Field_Click"
                AutomationProperties.Name="Recording date"
                AutomationProperties.HelpText="Opens a month grid to choose the day to investigate"
                ToolTip="Choose the day to investigate">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Path Style="{StaticResource IconPath}" Width="14" Height="14"
                      Fill="{DynamicResource Brush.TextSecondary}" Data="{StaticResource Icon.Calendar}" />
                <TextBlock x:Name="FieldText" Margin="8,0,0,0" FontSize="12.5" VerticalAlignment="Center" />
                <Path Style="{StaticResource IconPath}" Width="10" Height="10" Margin="10,0,0,0"
                      Fill="{DynamicResource Brush.TextMuted}" Data="{StaticResource Icon.ChevronDown}" />
            </StackPanel>
        </Button>

        <Popup x:Name="MonthPopup" Placement="Bottom" PlacementTarget="{Binding ElementName=Field}"
               StaysOpen="False" AllowsTransparency="True">
            <Border Margin="0,4,0,0" Width="272" Background="{DynamicResource Brush.Elevated}"
                    BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1" CornerRadius="8"
                    Padding="12" SnapsToDevicePixels="True">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.28" Color="#000000" />
                </Border.Effect>

                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Button Style="{StaticResource IconButton}" Width="26" Height="26" HorizontalAlignment="Left"
                                Click="PreviousMonth_Click" ToolTip="Previous month"
                                AutomationProperties.Name="Previous month">
                            <Path Style="{StaticResource IconPath}" Width="10" Height="10"
                                  Fill="{DynamicResource Brush.TextSecondary}" Data="{StaticResource Icon.ChevronLeft}" />
                        </Button>
                        <TextBlock x:Name="MonthTitle" Style="{StaticResource Strong}" FontSize="13"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Button Style="{StaticResource IconButton}" Width="26" Height="26" HorizontalAlignment="Right"
                                Click="NextMonth_Click" ToolTip="Next month"
                                AutomationProperties.Name="Next month">
                            <Path Style="{StaticResource IconPath}" Width="10" Height="10"
                                  Fill="{DynamicResource Brush.TextSecondary}" Data="{StaticResource Icon.ChevronRight}" />
                        </Button>
                    </Grid>

                    <ItemsControl x:Name="Weekdays">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="7" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{StaticResource Micro}"
                                           HorizontalAlignment="Center" Margin="0,2,0,6" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl x:Name="Days">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="7" Rows="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding DayNumber}" Click="Day_Click"
                                        Style="{StaticResource CalendarDayButton}"
                                        AutomationProperties.Name="{Binding Date, StringFormat='{}{0:dddd d MMMM yyyy}'}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Style="{StaticResource Hairline}" Margin="0,8,0,8" />

                    <Grid>
                        <Button Content="Today" Style="{StaticResource GhostButton}" Height="26" Padding="8,0"
                                HorizontalAlignment="Left" Click="Today_Click" />
                        <TextBlock Style="{StaticResource Micro}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Text="WEEKS START MONDAY" />
                    </Grid>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
