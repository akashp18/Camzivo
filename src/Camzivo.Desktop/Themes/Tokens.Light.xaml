<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Light theme: the same token names as the dark dictionary, re-tuned for contrast on light surfaces. Video
        surfaces stay near-black because footage is the bright content, not the interface.
    -->

    <!-- Structure -->
    <SolidColorBrush x:Key="Brush.Canvas" Color="#F3F5F8" />
    <SolidColorBrush x:Key="Brush.Graphite" Color="#F3F5F8" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.Elevated" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.SurfaceHover" Color="#EEF2F6" />
    <SolidColorBrush x:Key="Brush.Pressed" Color="#E3E9F0" />
    <SolidColorBrush x:Key="Brush.Selected" Color="#E1EDF7" />
    <SolidColorBrush x:Key="Brush.SelectedHover" Color="#D3E5F4" />
    <SolidColorBrush x:Key="Brush.DisabledSurface" Color="#EDF1F5" />
    <SolidColorBrush x:Key="Brush.DisabledText" Color="#9AA5B1" />
    <SolidColorBrush x:Key="Brush.Border" Color="#DCE2E9" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="#C2CBD5" />
    <SolidColorBrush x:Key="Brush.Focus" Color="#1F6FA8" />

    <!-- Text -->
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="#10151B" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#54616E" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#78848F" />
    <SolidColorBrush x:Key="Brush.TextOnAccent" Color="#FFFFFF" />

    <!-- Accent and status -->
    <SolidColorBrush x:Key="Brush.Accent" Color="#1F6FA8" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#2C82BE" />
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="#185B8C" />
    <SolidColorBrush x:Key="Brush.AccentText" Color="#175D8F" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#E1EDF7" />
    <SolidColorBrush x:Key="Brush.Success" Color="#1C7A55" />
    <SolidColorBrush x:Key="Brush.SuccessSoft" Color="#E3F3EC" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#8A5A00" />
    <SolidColorBrush x:Key="Brush.WarningSoft" Color="#FBF0DA" />
    <SolidColorBrush x:Key="Brush.Critical" Color="#B3353B" />
    <SolidColorBrush x:Key="Brush.CriticalSoft" Color="#FBE7E8" />
    <SolidColorBrush x:Key="Brush.Info" Color="#2B6FA0" />
    <SolidColorBrush x:Key="Brush.InfoSoft" Color="#E3EFF7" />
    <SolidColorBrush x:Key="Brush.NeutralBadge" Color="#E9EEF4" />

    <!-- Inputs -->
    <SolidColorBrush x:Key="Brush.InputBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.InputBorder" Color="#C9D2DC" />
    <SolidColorBrush x:Key="Brush.InputBorderHover" Color="#9FAEBD" />
    <SolidColorBrush x:Key="Brush.Placeholder" Color="#8895A2" />

    <!-- Tables and lists -->
    <SolidColorBrush x:Key="Brush.TableHeader" Color="#F7F9FB" />
    <SolidColorBrush x:Key="Brush.RowHover" Color="#F1F5F9" />
    <SolidColorBrush x:Key="Brush.RowSelected" Color="#E1EDF7" />

    <!-- Video surfaces stay near-black in every theme. -->
    <SolidColorBrush x:Key="Brush.VideoSurface" Color="#0B0F14" />
    <SolidColorBrush x:Key="Brush.VideoScrim" Color="#B3000000" />
    <SolidColorBrush x:Key="Brush.VideoTextMuted" Color="#9BA6B2" />
    <SolidColorBrush x:Key="Brush.TileOverlay" Color="#CC0B0F14" />
    <SolidColorBrush x:Key="Brush.PtzSurface" Color="#F2FFFFFF" />

    <!-- Recording timeline -->
    <SolidColorBrush x:Key="Brush.TimelineTrack" Color="#E4E9EF" />
    <SolidColorBrush x:Key="Brush.TimelineSegment" Color="#2E7DB0" />
    <SolidColorBrush x:Key="Brush.TimelineSegmentHover" Color="#3A92C9" />
    <SolidColorBrush x:Key="Brush.TimelineSegmentSelected" Color="#175D8F" />
    <SolidColorBrush x:Key="Brush.TimelinePlayhead" Color="#10151B" />
    <SolidColorBrush x:Key="Brush.TimelineTick" Color="#AAB6C2" />

    <!-- Chrome and overlays -->
    <SolidColorBrush x:Key="Brush.TooltipBackground" Color="#141A21" />
    <SolidColorBrush x:Key="Brush.TooltipBorder" Color="#2B3642" />
    <SolidColorBrush x:Key="Brush.DialogSurface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.NotificationSurface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.Scrim" Color="#6610151B" />
    <SolidColorBrush x:Key="Brush.Overlay" Color="#0D10151B" />
    <SolidColorBrush x:Key="Brush.Skeleton" Color="#E9EEF3" />
    <SolidColorBrush x:Key="Brush.Shadow" Color="#33000000" />

</ResourceDictionary>
