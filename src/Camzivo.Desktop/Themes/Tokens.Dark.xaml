<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Dark theme. These are the only colour values the application may use; views bind with DynamicResource so a
        theme switch never needs a restart. Documented in docs/UI_UX_DESIGN_SYSTEM.md.
    -->

    <!-- Structure -->
    <SolidColorBrush x:Key="Brush.Canvas" Color="#101419" />
    <SolidColorBrush x:Key="Brush.Graphite" Color="#101419" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#1B222B" />
    <SolidColorBrush x:Key="Brush.Elevated" Color="#222C36" />
    <SolidColorBrush x:Key="Brush.SurfaceHover" Color="#232D38" />
    <SolidColorBrush x:Key="Brush.Pressed" Color="#182029" />
    <SolidColorBrush x:Key="Brush.Selected" Color="#1F3040" />
    <SolidColorBrush x:Key="Brush.SelectedHover" Color="#263B4E" />
    <SolidColorBrush x:Key="Brush.DisabledSurface" Color="#1E252D" />
    <SolidColorBrush x:Key="Brush.DisabledText" Color="#56636F" />
    <SolidColorBrush x:Key="Brush.Border" Color="#2B3642" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="#3A4756" />
    <SolidColorBrush x:Key="Brush.Focus" Color="#7DC0EA" />

    <!-- Text -->
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="#E9EFF5" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#98A7B5" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#687987" />
    <SolidColorBrush x:Key="Brush.TextOnAccent" Color="#FFFFFF" />

    <!-- Accent and status -->
    <SolidColorBrush x:Key="Brush.Accent" Color="#408DC4" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#56A1D5" />
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="#3479A8" />
    <SolidColorBrush x:Key="Brush.AccentText" Color="#7FBEEA" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#1B3040" />
    <SolidColorBrush x:Key="Brush.Success" Color="#4CC9A0" />
    <SolidColorBrush x:Key="Brush.SuccessSoft" Color="#16302A" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#E5AE54" />
    <SolidColorBrush x:Key="Brush.WarningSoft" Color="#33291A" />
    <SolidColorBrush x:Key="Brush.Critical" Color="#D96B70" />
    <SolidColorBrush x:Key="Brush.CriticalSoft" Color="#331E22" />
    <SolidColorBrush x:Key="Brush.Info" Color="#6FAEDC" />
    <SolidColorBrush x:Key="Brush.InfoSoft" Color="#1B2B3A" />
    <SolidColorBrush x:Key="Brush.NeutralBadge" Color="#26313C" />

    <!-- Inputs -->
    <SolidColorBrush x:Key="Brush.InputBackground" Color="#141A21" />
    <SolidColorBrush x:Key="Brush.InputBorder" Color="#34414E" />
    <SolidColorBrush x:Key="Brush.InputBorderHover" Color="#465767" />
    <SolidColorBrush x:Key="Brush.Placeholder" Color="#687987" />

    <!-- Tables and lists -->
    <SolidColorBrush x:Key="Brush.TableHeader" Color="#171E26" />
    <SolidColorBrush x:Key="Brush.RowHover" Color="#1F2832" />
    <SolidColorBrush x:Key="Brush.RowSelected" Color="#1C3040" />

    <!-- Video surfaces stay near-black in every theme: footage is the bright content. -->
    <SolidColorBrush x:Key="Brush.VideoSurface" Color="#0B0F14" />
    <SolidColorBrush x:Key="Brush.VideoScrim" Color="#B3000000" />
    <SolidColorBrush x:Key="Brush.VideoTextMuted" Color="#8A96A2" />
    <SolidColorBrush x:Key="Brush.TileOverlay" Color="#CC0B0F14" />
    <SolidColorBrush x:Key="Brush.PtzSurface" Color="#D91B222B" />

    <!-- Recording timeline -->
    <SolidColorBrush x:Key="Brush.TimelineTrack" Color="#202932" />
    <SolidColorBrush x:Key="Brush.TimelineSegment" Color="#3C86BC" />
    <SolidColorBrush x:Key="Brush.TimelineSegmentHover" Color="#4E9BCE" />
    <SolidColorBrush x:Key="Brush.TimelineSegmentSelected" Color="#79BEE9" />
    <SolidColorBrush x:Key="Brush.TimelinePlayhead" Color="#E9EFF5" />
    <SolidColorBrush x:Key="Brush.TimelineTick" Color="#4A5865" />

    <!-- Chrome and overlays -->
    <SolidColorBrush x:Key="Brush.TooltipBackground" Color="#0B1015" />
    <SolidColorBrush x:Key="Brush.TooltipBorder" Color="#3A4756" />
    <SolidColorBrush x:Key="Brush.DialogSurface" Color="#1B222B" />
    <SolidColorBrush x:Key="Brush.NotificationSurface" Color="#222C36" />
    <SolidColorBrush x:Key="Brush.Scrim" Color="#B3000000" />
    <SolidColorBrush x:Key="Brush.Overlay" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="Brush.Skeleton" Color="#24303C" />
    <SolidColorBrush x:Key="Brush.Shadow" Color="#66000000" />

</ResourceDictionary>
