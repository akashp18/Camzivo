    <!--
        Vector icons. Every glyph is a filled 16x16 path, so it inherits the surrounding colour and never depends on an
        icon font. IconPath is the shared presentation style; views override Fill when a state needs another colour.
    -->

    <Style x:Key="IconPath" TargetType="Path">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Fill" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

