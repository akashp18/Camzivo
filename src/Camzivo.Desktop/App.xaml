<Application x:Class="Camzivo.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Tokens.Dark.xaml" />
                <!-- Icons must be merged before Controls: the ComboBox template resolves Icon.ChevronDown with
                     StaticResource, which cannot see a dictionary merged after the one that uses it. -->
                <ResourceDictionary Source="Themes/Icons.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
