<Window x:Class="Camzivo.Desktop.Shell.DeviceDiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Device diagnostics"
        Width="640" Height="620"
        MinWidth="520" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Graphite}"
        FontFamily="{StaticResource Font.Ui}"
        UseLayoutRounding="True">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <Grid>
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding Name}" />
                    <TextBlock Style="{StaticResource Meta}" Margin="0,4,0,0">
                        <!-- Run.Text binds two-way by default; the view model is read-only, so it must be OneWay or the
                             window throws when it is shown. -->
                        <Run Text="{Binding Kind, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Address, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Text="{Binding Mode}" Style="{StaticResource Micro}" Margin="0,6,0,0"
                               Foreground="{DynamicResource Brush.Success}" />
                </StackPanel>
                <TextBlock Text="{Binding Probed}" Style="{StaticResource Micro}" HorizontalAlignment="Right" VerticalAlignment="Top" />
            </Grid>

            <Border Style="{StaticResource Panel}" Padding="12" Margin="0,14,0,10">
                <StackPanel>
                    <TextBlock Text="{Binding Identity}" Style="{StaticResource Strong}" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource Meta}" Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding DeviceTime}" />
                    <TextBlock Style="{StaticResource Meta}" Margin="0,2,0,0" TextWrapping="Wrap" Text="{Binding TimeZone}" />
                    <TextBlock Style="{StaticResource Meta}" Margin="0,2,0,0" Text="{Binding Channels}" />
                </StackPanel>
            </Border>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Panel}" Padding="0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="12,9">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="92" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Strong}" FontSize="12"
                                               VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding StateText}" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Micro}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding State}" Value="Supported">
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="Unsupported">
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Critical}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Grid.Column="2" Text="{Binding Detail}" Style="{StaticResource Meta}"
                                               TextWrapping="Wrap" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2">
            <Border Background="{DynamicResource Brush.SurfaceHover}" CornerRadius="6"
                    Padding="12" Margin="0,10,0,0"
                    Visibility="{Binding HasLastError, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="LAST CONNECTION ERROR" Style="{StaticResource Micro}" />
                    <TextBlock Text="{Binding LastError}" Style="{StaticResource Meta}" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Close" Style="{StaticResource SecondaryButton}" Height="32" MinWidth="90"
                        IsCancel="True" Click="Close_Click" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
