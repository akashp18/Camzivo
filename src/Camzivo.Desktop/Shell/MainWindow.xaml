<Window x:Class="Camzivo.Desktop.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Camzivo.Desktop.ViewModels"
        xmlns:views="clr-namespace:Camzivo.Desktop.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Camzivo"
        Width="1440" Height="900" MinWidth="1024" MinHeight="640"
        WindowStyle="None" Background="{DynamicResource Brush.Canvas}"
        FontFamily="{StaticResource Font.Ui}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.InputBindings>
        <KeyBinding Key="D1" Modifiers="Ctrl" Command="{Binding ApplyLayoutPresetCommand}" CommandParameter="1" />
        <KeyBinding Key="D2" Modifiers="Ctrl" Command="{Binding ApplyLayoutPresetCommand}" CommandParameter="4" />
        <KeyBinding Key="D3" Modifiers="Ctrl" Command="{Binding ApplyLayoutPresetCommand}" CommandParameter="9" />
        <KeyBinding Key="D4" Modifiers="Ctrl" Command="{Binding ApplyLayoutPresetCommand}" CommandParameter="16" />
        <KeyBinding Key="D5" Modifiers="Ctrl" Command="{Binding ApplyLayoutPresetCommand}" CommandParameter="25" />
        <KeyBinding Key="D6" Modifiers="Ctrl" Command="{Binding ApplyLayoutPresetCommand}" CommandParameter="36" />
        <KeyBinding Key="D7" Modifiers="Ctrl" Command="{Binding ApplyLayoutPresetCommand}" CommandParameter="49" />
        <KeyBinding Key="D8" Modifiers="Ctrl" Command="{Binding ApplyLayoutPresetCommand}" CommandParameter="64" />
        <KeyBinding Key="T" Modifiers="Ctrl" Command="{Binding ToggleThemeCommand}" />
        <KeyBinding Key="B" Modifiers="Ctrl" Command="{Binding ToggleSidebarCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:LiveViewModel}">
            <views:LiveView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:PlaybackViewModel}">
            <views:PlaybackView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:DevicesViewModel}">
            <views:DevicesView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:EventsViewModel}">
            <views:EventsView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ExportsViewModel}">
            <views:ExportsView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:HealthViewModel}">
            <views:HealthView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="TitleBarRow" Height="40" />
                <RowDefinition Height="*" />
                <RowDefinition Height="26" />
            </Grid.RowDefinitions>

            <!-- ===================== Title bar ===================== -->
            <Grid x:Name="TitleBar" Grid.Row="0" Background="{DynamicResource Brush.Surface}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Border Width="18" Height="18" CornerRadius="5" Background="{DynamicResource Brush.Accent}">
                        <Path Width="10" Height="10" Stretch="Uniform" Fill="{DynamicResource Brush.TextOnAccent}"
                              Data="{StaticResource Icon.Playback}" />
                    </Border>
                    <TextBlock Text="Camzivo" FontFamily="{StaticResource Font.Display}" FontSize="13" FontWeight="SemiBold"
                               Margin="9,0,0,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding VersionLabel}" Style="{StaticResource Micro}" Margin="7,0,0,0" VerticalAlignment="Center" />
                    <Border Style="{StaticResource Hairline}" Width="1" Height="14" Margin="12,0" />
                    <TextBlock Text="{Binding HeaderTitle}" Style="{StaticResource Body}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding HeaderContext}" Style="{StaticResource Meta}" VerticalAlignment="Center"
                               Margin="10,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="420" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Border Style="{StaticResource Chip}" Margin="0,0,8,0" Background="{DynamicResource Brush.NeutralBadge}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,6,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource Brush.TextMuted}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasLiveStreams}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource Brush.Success}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding EngineBadgeText}" Style="{StaticResource Micro}" />
                        </StackPanel>
                    </Border>

                    <Button Style="{StaticResource ChromeButton}" Width="38" Click="Theme_Click"
                            ToolTip="{Binding ThemeToggleHint}" AutomationProperties.Name="Toggle theme">
                        <Path Width="13" Height="13" Stretch="Uniform" Fill="{DynamicResource Brush.TextSecondary}">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Data" Value="{StaticResource Icon.Sun}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDark}" Value="True">
                                            <Setter Property="Data" Value="{StaticResource Icon.Moon}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Button>

                    <Button Style="{StaticResource ChromeButton}" Click="Minimize_Click"
                            ToolTip="Minimise" AutomationProperties.Name="Minimise">
                        <Path Width="10" Height="10" Stretch="Uniform" Fill="{DynamicResource Brush.TextSecondary}"
                              Data="{StaticResource Icon.Minimize}" />
                    </Button>
                    <Button Style="{StaticResource ChromeButton}" Click="Maximize_Click"
                            ToolTip="Maximise" AutomationProperties.Name="Maximise">
                        <Path Width="10" Height="10" Stretch="Uniform" Fill="{DynamicResource Brush.TextSecondary}"
                              Data="{StaticResource Icon.Maximize}" />
                    </Button>
                    <Button Style="{StaticResource CloseChromeButton}" Click="Close_Click"
                            ToolTip="Close" AutomationProperties.Name="Close">
                        <Path Width="10" Height="10" Stretch="Uniform" Fill="{DynamicResource Brush.TextSecondary}"
                              Data="{StaticResource Icon.Close}" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ===================== Body ===================== -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding SidebarWidth}" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{DynamicResource Brush.Surface}"
                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,1,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Bottom" Margin="8,0,8,10">
                            <Border Style="{StaticResource Hairline}" Margin="0,0,0,8" />
                            <Button Style="{StaticResource NavButton}" Command="{Binding ToggleSidebarCommand}"
                                    ToolTip="{Binding SidebarToggleHint}" AutomationProperties.Name="Toggle navigation">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Path Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Left"
                                          Fill="{DynamicResource Brush.TextMuted}">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Setter Property="Data" Value="{StaticResource Icon.ChevronLeft}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                                                        <Setter Property="Data" Value="{StaticResource Icon.ChevronRight}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                    <TextBlock Grid.Column="1" Text="Collapse" FontSize="12.5" VerticalAlignment="Center"
                                               Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource InverseBoolToVis}}" />
                                </Grid>
                            </Button>
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding Sections}" Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="8,1">
                                        <Border x:Name="Active" CornerRadius="6" Background="Transparent" />
                                        <Border x:Name="Rail" Width="2" HorizontalAlignment="Left" CornerRadius="1"
                                                Margin="0,7" Background="{DynamicResource Brush.Accent}"
                                                Visibility="Collapsed" />
                                        <Button Style="{StaticResource NavButton}" Height="38" Margin="0"
                                                Command="{Binding DataContext.SelectSectionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="{Binding Hint}"
                                                AutomationProperties.Name="{Binding Title}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="26" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Path Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Left"
                                                      VerticalAlignment="Center"
                                                      Data="{Binding IconKey, Converter={StaticResource IconGeometry}}">
                                                    <Path.Style>
                                                        <Style TargetType="Path">
                                                            <Setter Property="Fill" Value="{DynamicResource Brush.TextMuted}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter Property="Fill" Value="{DynamicResource Brush.AccentText}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                </Path>
                                                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                           Visibility="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVis}}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </Button>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="Active" Property="Background" Value="{DynamicResource Brush.Selected}" />
                                            <Setter TargetName="Rail" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{DynamicResource Brush.WarningSoft}" Padding="14,8"
                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,1"
                            Visibility="{Binding HasBanner, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding BannerText}" Foreground="{DynamicResource Brush.TextPrimary}" TextWrapping="Wrap" />
                    </Border>

                    <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" />
                </Grid>
            </Grid>

            <!-- ===================== Status bar ===================== -->
            <Border Grid.Row="2" Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0">
                <Grid Margin="12,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="5" Height="5" VerticalAlignment="Center" Margin="0,0,7,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource Brush.TextMuted}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasLiveStreams}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource Brush.Success}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding StatusLeft}" Style="{StaticResource Mono}" FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border Style="{StaticResource Chip}" Padding="5,1" Margin="0,0,10,0">
                            <TextBlock Text="LOCAL" Style="{StaticResource Micro}" />
                        </Border>
                        <TextBlock Text="{Binding StatusRight}" Style="{StaticResource Mono}" FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
