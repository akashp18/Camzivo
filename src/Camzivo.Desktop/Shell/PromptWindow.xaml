<Window x:Class="Camzivo.Desktop.Shell.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Camzivo" Width="460" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize" Background="Transparent" AllowsTransparency="True"
        FontFamily="{StaticResource Font.Ui}" UseLayoutRounding="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0"
                            CornerRadius="8" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Background="{DynamicResource Brush.DialogSurface}"
            BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1" CornerRadius="8"
            Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.3" Color="#000000" />
        </Border.Effect>
        <StackPanel Margin="18">
            <TextBlock x:Name="HeadingText" Text="Rename" Style="{StaticResource Strong}" FontSize="14" />
            <TextBlock x:Name="MessageText" Style="{StaticResource Meta}" TextWrapping="Wrap" Margin="0,6,0,0" />

            <TextBlock Text="NAME" Style="{StaticResource Micro}" Margin="0,12,0,4" />
            <TextBox x:Name="ValueBox" Style="{StaticResource InputTextBox}" Height="32"
                     KeyDown="Value_KeyDown" AutomationProperties.Name="Name" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Height="30" MinWidth="84"
                        IsCancel="True" Click="Cancel_Click" />
                <Button x:Name="OkButton" Content="Save" Style="{StaticResource PrimaryButton}" Height="30" MinWidth="84"
                        Margin="8,0,0,0" IsDefault="True" Click="Ok_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
