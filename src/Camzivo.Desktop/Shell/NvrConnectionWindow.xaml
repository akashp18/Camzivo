<Window x:Class="Camzivo.Desktop.Shell.NvrConnectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Test NVR connection"
        Width="660" Height="780"
        MinWidth="560" MinHeight="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource Brush.Graphite}"
        FontFamily="{StaticResource Font.Ui}"
        UseLayoutRounding="True">

    <DockPanel Margin="20">

        <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      MaxHeight="500">
            <StackPanel>

                <TextBlock Text="Test NVR connection" Style="{StaticResource SectionTitle}" />
                <TextBlock Style="{StaticResource Meta}" Margin="0,6,0,16" TextWrapping="Wrap"
                           Text="Enter the recorder's details yourself. The test reads metadata only: it opens no video, searches no recordings and changes no setting on the recorder. Nothing is saved and no connection is made until you confirm." />

                <TextBlock Text="NVR IP ADDRESS OR HOSTNAME" Style="{StaticResource Micro}" Margin="0,0,0,4" />
                <TextBox x:Name="HostBox" Style="{StaticResource InputTextBox}" Height="32"
                         Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="NVR IP address or hostname"
                         ToolTip="For example 192.168.1.108 or nvr.example.local — the address only"
                         TabIndex="0" />

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="140" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="CONNECTION PROTOCOL" Style="{StaticResource Micro}" Margin="0,0,0,4" />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Height="32">
                            <RadioButton x:Name="HttpRadio" Content="HTTP" GroupName="Protocol"
                                         IsChecked="{Binding IsHttp, Mode=TwoWay}"
                                         AutomationProperties.Name="HTTP" VerticalAlignment="Center" TabIndex="1" />
                            <RadioButton x:Name="HttpsRadio" Content="HTTPS" GroupName="Protocol" Margin="16,0,0,0"
                                         IsChecked="{Binding IsHttps, Mode=TwoWay}"
                                         AutomationProperties.Name="HTTPS" VerticalAlignment="Center" TabIndex="2" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="ONVIF PORT" Style="{StaticResource Micro}" Margin="0,0,0,4" />
                        <TextBox x:Name="PortBox" Style="{StaticResource InputTextBox}" Height="32"
                                 Text="{Binding PortText, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="ONVIF port"
                                 ToolTip="HTTP defaults to 80, HTTPS to 443"
                                 TabIndex="3" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="USERNAME" Style="{StaticResource Micro}" Margin="0,12,0,4" />
                <TextBox x:Name="UserBox" Style="{StaticResource InputTextBox}" Height="32"
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Username" TabIndex="4" />

                <TextBlock Text="PASSWORD" Style="{StaticResource Micro}" Margin="0,12,0,4" />
                <Grid>
                    <PasswordBox x:Name="PasswordBox" Height="32" Padding="10,0" VerticalContentAlignment="Center"
                                 Background="{DynamicResource Brush.InputBackground}"
                                 Foreground="{DynamicResource Brush.TextPrimary}"
                                 BorderBrush="{DynamicResource Brush.InputBorder}"
                                 AutomationProperties.Name="Password"
                                 Visibility="{Binding IsPasswordRevealed, Converter={StaticResource InverseBoolToVis}}"
                                 TabIndex="5" />
                    <TextBox x:Name="PlainPasswordBox" Style="{StaticResource InputTextBox}" Height="32"
                             AutomationProperties.Name="Password (shown)"
                             Visibility="{Binding IsPasswordRevealed, Converter={StaticResource BoolToVis}}"
                             TabIndex="6" />
                </Grid>
                <CheckBox x:Name="RevealCheck" Content="Show password" Margin="0,8,0,0"
                          IsChecked="{Binding IsPasswordRevealed, Mode=TwoWay}"
                          Checked="Reveal_Changed" Unchecked="Reveal_Changed"
                          TabIndex="7" />
                <TextBlock Style="{StaticResource Meta}" Margin="0,6,0,0" TextWrapping="Wrap"
                           Text="The password stays in this window for one attempt. It is not saved, not placed on a command line, and never written to logs or reports." />

                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <Button Content="Test connection" Style="{StaticResource PrimaryButton}" Height="32"
                            MinWidth="130"
                            IsDefault="{Binding CanTest}"
                            Click="Test_Click"
                            AutomationProperties.Name="Test connection"
                            TabIndex="8" />
                    <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Height="32" MinWidth="90"
                            Margin="8,0,0,0" Click="Cancel_Click"
                            AutomationProperties.Name="Cancel"
                            TabIndex="9" />
                </StackPanel>

                <TextBlock Text="{Binding Error}" Style="{StaticResource ErrorMessage}" Margin="0,10,0,0"
                           Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Close" Style="{StaticResource SecondaryButton}" Height="32" MinWidth="90"
                    Click="Cancel_Click" AutomationProperties.Name="Close window" />
        </StackPanel>

        <Border Style="{StaticResource Panel}" Margin="0,12,0,0" Padding="0">
            <Grid>
                <TextBlock Style="{StaticResource Meta}" Margin="16" TextWrapping="Wrap"
                           Visibility="{Binding IsIdle, Converter={StaticResource BoolToVis}}"
                           Text="Nothing has been tested. Enter the address, protocol and port, then choose Test connection. You will be asked to confirm the exact destination before any request is sent." />

                <!-- Confirmation: the only path to a request is the button inside this panel. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding IsConfirming, Converter={StaticResource BoolToVis}}">
                <StackPanel Margin="16">
                    <TextBlock Text="Confirm this test" Style="{StaticResource Strong}" />
                    <TextBlock Style="{StaticResource Meta}" Margin="0,6,0,0" TextWrapping="Wrap"
                               Text="This test will read basic information and camera metadata from the selected NVR. It will not open video streams, search recordings, or modify NVR settings." />

                    <Border Background="{DynamicResource Brush.SurfaceHover}" CornerRadius="6" Padding="10,8"
                            Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="DESTINATION" Style="{StaticResource Micro}" />
                            <TextBlock Text="{Binding ConfirmationDetail}" Style="{StaticResource Mono}"
                                       Margin="0,3,0,0" TextWrapping="Wrap"
                                       AutomationProperties.Name="Destination" />
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="RunTestButton" Content="Run metadata test" Style="{StaticResource PrimaryButton}" Height="32"
                                MinWidth="150" IsDefault="{Binding IsConfirming}" Click="Confirm_Click"
                                AutomationProperties.Name="Run metadata test" />
                        <Button Content="Not now" Style="{StaticResource SecondaryButton}" Height="32" MinWidth="90"
                                Margin="8,0,0,0" Click="Decline_Click"
                                AutomationProperties.Name="Not now" />
                    </StackPanel>
                </StackPanel>
                </ScrollViewer>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding IsTesting, Converter={StaticResource BoolToVis}}">
                <StackPanel Margin="16">
                    <TextBlock Text="Reading metadata…" Style="{StaticResource Strong}" />
                    <TextBlock Text="{Binding Progress}" Style="{StaticResource Meta}" Margin="0,4,0,0" TextWrapping="Wrap" />
                    <ProgressBar IsIndeterminate="True" Margin="0,10,0,0" Height="4" />
                    <TextBlock Style="{StaticResource Meta}" Margin="0,10,0,0" TextWrapping="Wrap"
                               Text="Sequential requests only, at most 20 attempts, 60 seconds, no redirects, no RTSP and no recording access." />
                    <Button Content="Cancel test" Style="{StaticResource SecondaryButton}" Height="32" MinWidth="110"
                            HorizontalAlignment="Left" Margin="0,10,0,0" Click="CancelTest_Click"
                            AutomationProperties.Name="Cancel test" />
                </StackPanel>
                </ScrollViewer>

                <Grid Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}" Margin="0,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Strong}" Margin="16,14,16,6" />

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8">
                        <ItemsControl ItemsSource="{Binding Rows}" Margin="16,0,16,0" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource Micro}"
                                                   VerticalAlignment="Top" Margin="0,2,12,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource Body}"
                                                   TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>
    </DockPanel>
</Window>
